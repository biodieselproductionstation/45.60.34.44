README.md
# การตั้งค่าใช้ได้กับ Linux distros ทั้งหมดที่ทํางานบน WSL 2
[wsl2]

# จํากัดหน่วยความจํา VM ให้ใช้งานได้ไม่เกิน 4 GB ซึ่งสามารถตั้งค่าเป็นตัวเลขทั้งหมดได้โดยใช้ GB หรือ MB
หน่วยความจํา=4GB

# ตั้งค่า VM เพื่อใช้โปรเซสเซอร์เสมือนสองตัว
โปรเซสเซอร์=2

# ระบุเคอร์เนล Linux แบบกําหนดเองเพื่อใช้กับ distros ที่ติดตั้งของคุณ เคอร์เนลเริ่มต้นที่ใช้สามารถพบได้ที่ https://github.com/microsoft/WSL2-Linux-Kernel
เคอร์เนล=C:\\temp\\myCustomKernel

# ระบุโมดูล VHD สําหรับเคอร์เนล Linux แบบกําหนดเองเพื่อใช้กับ distros ที่ติดตั้งของคุณ
kernelModules=C:\\temp\\modules.vhdx

# ตั้งค่าพารามิเตอร์เคอร์เนลเพิ่มเติม ในกรณีนี้ เปิดใช้งานอิมเมจฐาน Linux รุ่นเก่า เช่น Centos 6
kernelCommandLine = vsyscall=เลียนแบบ

# กําหนดจํานวนพื้นที่เก็บข้อมูลสลับเป็น 8GB ค่าเริ่มต้นคือ 25% ของ RAM ที่มีอยู่
สวอป=8GB

# ตั้งค่าตําแหน่งเส้นทาง swapfile ค่าเริ่มต้นคือ %UserProfile%\AppData\Local\Temp\swap.vhdx
swapfile=C:\\temp\\wsl-swap.vhdx

# เปิดการเชื่อมต่อเริ่มต้นเพื่อผูก WSL 2 localhost กับ Windows localhost การตั้งค่าจะถูกละเว้นเมื่อ networkingMode=mirrored
การส่งต่อโฮสติ้งท้องถิ่น=จริง

# ปิดใช้งานการจําลองเสมือนแบบซ้อน
การจําลองเสมือนแบบซ้อน=เท็จ

# เปิดคอนโซลเอาต์พุตที่แสดงเนื้อหาของ dmesg เมื่อเปิด WSL 2 distro สําหรับการดีบัก
ดีบักคอนโซล=จริง

# ตั้งค่าจํานวนสูงสุดของไฟล์ถ่ายโอนข้อมูลความผิดพลาดที่จะเก็บรักษา (ค่าเริ่มต้นคือ 10)
maxCrashDumpCount=10

# เปิดใช้งานคุณสมบัติการทดลอง
[ทดลอง]
sparseVhd=จริง
